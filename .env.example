# Configure this in Netlify, Functions scope. Never commit real secrets.
AGENT_GAMES_HMAC_SECRET=
# Independent private proof salt key; optional, defaults to domain-separated HMAC secret.
PROOF_SALT_SECRET=
# Local development only. The default competition service uses Netlify Blobs.
PORT=8787
# TESTNET Kurier key for npm run verify:testnet. Never use a mainnet key here.
KURIER_API_KEY=
